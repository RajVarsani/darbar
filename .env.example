# Copy to .env (gitignored). Every value here drives the whole app; defaults in src/config.ts.
PORT=4899
BASE_URL=http://localhost:4899        # what board links + Gabbar replies point at (tunnel URL when shared)
BIND_HOST=127.0.0.1                   # loopback only; never 0.0.0.0 without auth in front
MONGO_URI=mongodb://localhost:27017
DB_NAME=mission_control
# MC_API=http://localhost:4899/api    # internal API calls; defaults to localhost:PORT regardless of BASE_URL
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...              # app-level token, Socket Mode
PROXY_PORT=4800
PROXY_ADMIN_TOKEN=change-me               # gates the proxy's /-/ admin endpoints (local only anyway)
# NGROK_DOMAIN=your-name.ngrok-free.app   # permanent domain; scripts/tunnel.sh uses it
# DAR-266 Linear mirror for linear-native projects; unset = off. Personal key, no Bearer prefix.
# LINEAR_API_KEY=
# LINEAR_POLL_MS=120000
ANTHROPIC_API_KEY=sk-ant-...           # gabbar's brain (claude api)
GABBAR_OWNER_ID=U...                   # slack user id of the owner (full trust)
# GABBAR_MODEL=claude-opus-5           # override the agent model
# GABBAR_TRIAGE_MODEL=claude-haiku-4-5 # cheap tier: chat-vs-work classifier + chit-chat replies
# MEMORY_DIR=/path/to/vault            # gabbar's markdown memory (obsidian-compatible)
# PARKED_DIR=/path/to/parked           # reports the gate refused; gabbar writes, the board reads
# DAR-323 T3 Code feedback outbox (per project opt-in via set_t3). DARBAR_T3=off is the global kill switch.
# DARBAR_T3=on
# T3_MODEL=claude-opus-5-5             # model for a NEW "<PREFIX> orchestrator" thread
# T3_CLI=/Users/you/.t3/bin/t3
# T3_TIMEOUT_MS=60000
# T3_SWEEP_MS=30000
# DAR-419 context watcher (apps/ctxwatch): % in the T3 thread title, handoff + fresh /darbar-resume at the threshold.
# CTXWATCH=off is the kill switch (DARBAR_T3=off stops it too).
# CTXWATCH=on
# CTXWATCH_THRESHOLD=80                # percent of the model's context window
# CTXWATCH_BUCKET_STEP=5               # title % changes only when this bucket does
# CTXWATCH_POLL_MS=15000
# CTXWATCH_PHASE_POLL_MS=2000          # poll rate while a handoff run is pending
# CTXWATCH_ACTIVE_HOURS=72
# CTXWATCH_MIN_GAP_MS=600000          # loop guard between two handoffs on one thread
# CTXWATCH_HANDOFF_MSG="run /darbar-handoff now"
# CTXWATCH_RESUME_MSG=/darbar-resume
# CTXWATCH_ONLY_THREADS=<id>,<id>      # allowlist (testing); empty = every top-level thread
# CTXWATCH_SKIP_THREADS=<id>,<id>      # per-thread opt-out (also: bun run ctxwatch:optout <id>)
# CTXWATCH_WINDOWS={"model":1000000}   # fallback window when T3 reports none
# CTXWATCH_EVENT_PROJECT=DAR           # board prefix that receives the watcher's events
# CTXWATCH_RETRIES=4
# CTXWATCH_BACKOFF_MS=1000
# T3_STATE_DB=/Users/you/.t3/userdata/statev2.sqlite
