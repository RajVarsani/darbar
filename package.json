{
  "name": "houston",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "server": "bun run --filter @houston/server dev",
    "gabbar": "bun run --filter @houston/gabbar dev",
    "proxy": "bun run --filter @houston/proxy dev",
    "mcp": "bun --env-file=.env apps/mcp/src/server.ts",
    "tunnel": "sh scripts/tunnel.sh",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.5.0"
  }
}